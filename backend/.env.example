NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ar_safety_training
CORS_ORIGIN=https://ar-industrial-safety-training.vercel.app
PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-value-before-authentication-is-enabled
JWT_EXPIRES_IN_SECONDS=28800
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# Optional: set both values before running db:seed to create a demo admin.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=zentrix123
